# =====================================================================
# BookScan Backend — Environment Variable Template
# =====================================================================
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env to version control.
# Production secrets should be configured in Render's environment dashboard.
# =====================================================================

# ---------------------------------------------------------------------------
# Supabase (required for all DB-backed routes)
# ---------------------------------------------------------------------------

# Your Supabase project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service_role key (NOT the anon key — this bypasses RLS).
# Find it in: Supabase dashboard → Settings → API → service_role
# Keep this server-side only. Never commit the real value; rotate it if exposed.
SUPABASE_SERVICE_KEY=paste-your-service-role-key-here

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated list of allowed frontend origins.
# Use * to allow all origins (only for development).
# Example: https://bookscan.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Server (optional — Render injects PORT automatically)
# ---------------------------------------------------------------------------

# Port the uvicorn server listens on.
PORT=8000

# Python path (set to . when running from the backend/ directory).
PYTHONPATH=.

# ---------------------------------------------------------------------------
# OCR (optional — only needed if running the scan/OCR pipeline)
# ---------------------------------------------------------------------------

# Path to the Tesseract binary if it is not on the system PATH.
# Example on macOS (Homebrew): /usr/local/bin/tesseract
# Example on Ubuntu: /usr/bin/tesseract
# Leave unset to use the system default.
# TESSERACT_CMD=/usr/bin/tesseract

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# • The app boots successfully with only PORT and PYTHONPATH set.
#   Routes that need Supabase will return HTTP 503 until credentials are set.
# • SUPABASE_SERVICE_KEY has full database access. Keep it secret.
# • Rotate SUPABASE_SERVICE_KEY in the Supabase dashboard if leaked.
