# =====================================================================
# BookScan Backend — Environment Variable Template
# =====================================================================
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env to version control.
# Production secrets should be configured in Render's environment dashboard.
# =====================================================================

# ---------------------------------------------------------------------------
# Neon PostgreSQL (required for all DB-backed routes)
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string
# Format: postgresql://user:password@host/dbname?sslmode=require
# Get this from your Neon dashboard → Connection Details → Connection string
DATABASE_URL=postgresql://user:password@ep-xxxxx.region.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Local filesystem storage for scan images and OCR text
# ---------------------------------------------------------------------------

# Local filesystem directory for scan images and OCR text output
# Default: ./storage (relative to the backend directory)
STORAGE_DIR=./storage

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated list of allowed frontend origins.
# Use * to allow all origins (only for development).
# Example: https://bookscan.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Server (optional — Render injects PORT automatically)
# ---------------------------------------------------------------------------

# Port the uvicorn server listens on.
PORT=8000

# Python path (set to . when running from the backend/ directory).
PYTHONPATH=.

# ---------------------------------------------------------------------------
# OCR (optional — only needed if running the scan/OCR pipeline)
# ---------------------------------------------------------------------------

# Path to the Tesseract binary if it is not on the system PATH.
# Example on macOS (Homebrew): /usr/local/bin/tesseract
# Example on Ubuntu: /usr/bin/tesseract
# Leave unset to use the system default.
# TESSERACT_CMD=/usr/bin/tesseract

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# • The app boots successfully with only PORT and PYTHONPATH set.
#   Routes that need the database will return HTTP 503 until DATABASE_URL is set.
# • DATABASE_URL grants full database access. Keep it secret.
# • Rotate the Neon password in the Neon dashboard if leaked.
