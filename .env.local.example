# ============================================================
# BookScan — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ----------------------------------------------------------------
# Frontend API (public — exposed to the browser)
# ----------------------------------------------------------------

# Base URL of the FastAPI backend, WITHOUT trailing slash.
# e.g. https://bookscan-api.onrender.com
# Leave empty (or set NEXT_PUBLIC_MOCK_MODE=true) to run in mock mode
# with no backend required.
NEXT_PUBLIC_API_URL=

# Set to "true" to run the entire frontend in mock mode.
# In mock mode all API calls resolve from lib/mockData.ts.
# Automatic when NEXT_PUBLIC_API_URL is empty.
NEXT_PUBLIC_MOCK_MODE=true

# ----------------------------------------------------------------
# Backend proxy (server-only — never exposed to the browser)
# ----------------------------------------------------------------

# The FastAPI backend URL used by the Next.js proxy route at
# /api/triage. Keep this server-side so the backend origin stays
# hidden from clients if desired.
BACKEND_API_URL=http://localhost:8000

# Optional API key forwarded to the backend as X-API-Key.
# BACKEND_API_KEY=
